# PostgreSQL connection string. Required: the app does not run without a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ampy_jobs

# Set to true when running behind a provider that requires SSL.
PGSSL=false

# Only needed while accounts created before 2026-10-27 still have their old password hash.
# Each one is upgraded the first time that employee signs in. Not used for anything else.
ADMIN_KEY=
